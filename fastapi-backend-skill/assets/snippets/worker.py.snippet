import asyncio
import logging
from collections.abc import Awaitable, Callable
from dataclasses import dataclass


logger = logging.getLogger(__name__)


@dataclass(frozen=True)
class WorkerConfig:
    interval_seconds: int
    timeout_seconds: int


async def run_worker_generic(
    *,
    name: str,
    tick: Callable[[], Awaitable[None]],
    config: WorkerConfig,
    shutdown: asyncio.Event,
) -> None:
    logger.info(f"worker {name} started")
    while not shutdown.is_set():
        try:
            await asyncio.wait_for(tick(), timeout=config.timeout_seconds)
        except TimeoutError:
            logger.exception(f"worker {name} tick timed out")
        except Exception:
            logger.exception(f"worker {name} tick failed")

        try:
            await asyncio.wait_for(shutdown.wait(), timeout=config.interval_seconds)
        except TimeoutError:
            pass
    logger.info(f"worker {name} stopped")

