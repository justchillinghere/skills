[project]
name = "fastapi-backend"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "alembic>=1.16",
    "fastapi[standard]>=0.116",
    "httpx>=0.28",
    "prometheus-client>=0.22",
    "psycopg[binary]>=3.2",
    "pydantic>=2.11",
    "pydantic-settings>=2.10",
    "python-dotenv>=1.1",
    "redis>=6.2",
    "sqlalchemy>=2.0",
    "uvicorn>=0.35",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/app"]

[dependency-groups]
dev = [
    "pytest>=8.4",
    "pytest-asyncio>=1.0",
    "pytest-cov>=6.0",
    "ruff>=0.12",
    "testcontainers[postgres,redis]>=4.12",
]

[tool.pytest.ini_options]
pythonpath = ["src", "."]
testpaths = ["tests"]
addopts = ["--import-mode=importlib"]
asyncio_mode = "auto"

[tool.ruff]
exclude = ["alembic/versions/*.py", "alembic/env.py"]

[tool.pyright]
extraPaths = ["src"]

