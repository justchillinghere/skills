import asyncio
import logging
from collections.abc import Awaitable, Callable
from dataclasses import dataclass
from typing import TypeVar


logger = logging.getLogger(__name__)
T = TypeVar("T")


@dataclass(frozen=True)
class BatchWorkerConfig:
    interval_seconds: int
    timeout_seconds: int
    batch_size: int


async def run_worker_batch_processor(
    *,
    name: str,
    claim_batch: Callable[[int], Awaitable[list[T]]],
    process_one: Callable[[T], Awaitable[None]],
    config: BatchWorkerConfig,
    shutdown: asyncio.Event,
) -> None:
    logger.info(f"batch worker {name} started")
    while not shutdown.is_set():
        try:
            batch = await asyncio.wait_for(
                claim_batch(config.batch_size),
                timeout=config.timeout_seconds,
            )
            for item in batch:
                try:
                    await asyncio.wait_for(
                        process_one(item),
                        timeout=config.timeout_seconds,
                    )
                except Exception:
                    logger.exception(f"batch worker {name} item failed")
        except TimeoutError:
            logger.exception(f"batch worker {name} tick timed out")
        except Exception:
            logger.exception(f"batch worker {name} tick failed")

        try:
            await asyncio.wait_for(shutdown.wait(), timeout=config.interval_seconds)
        except TimeoutError:
            pass
    logger.info(f"batch worker {name} stopped")

